# Copy to .env and fill in real values. NO MOCK MODE: at least one LLM
# provider key below is REQUIRED. The require-api-key skill checks for a
# key and makes one real verification call before any design or code work
# starts — nothing builds without a working key.

# --- LLM providers (at least one REQUIRED; provider-swappable code in
# _shared/llm_client.py picks whichever is set — no fallback if none is) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# --- Vector DB (Qdrant Cloud preferred for "comprehensive RAG" projects;
# required only for projects whose design.md specifies RAG/vector search) ---
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=coding_agent_demo

# --- Relational / auth (Supabase; required only if design.md specifies it) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Observability (Phoenix Cloud; required only for projects using
# eval-and-observability with Phoenix specifically) ---
PHOENIX_COLLECTOR_ENDPOINT=
PHOENIX_API_KEY=

# --- Deployment targets (used only by the deploy-config skill) ---
VERCEL_TOKEN=
RENDER_API_KEY=

# --- teaching/incident-root-cause-agent (required only when running that
# demo's backend/frontend — see its README's "Persistence lifecycle"/auth
# notes). Comma-separated list of accepted backend API keys; the frontend
# needs one of these same values in INCIDENT_AGENT_API_KEY. No unauthenticated
# mode — backend/auth.py fails loudly at import if this is unset. ---
INCIDENT_AGENT_API_KEYS=
INCIDENT_AGENT_API_KEY=
INCIDENT_AGENT_MAX_TOKENS_PER_INCIDENT=
INCIDENT_AGENT_PRECEDENT_SIMILARITY_THRESHOLD=

# --- Optional real Jira via mcp-atlassian ---
# Jira Cloud: set URL + account email + API token.
# Jira Server/Data Center: set URL + personal token instead.
JIRA_URL=
JIRA_USERNAME=
JIRA_API_TOKEN=
JIRA_PERSONAL_TOKEN=
JIRA_PROJECT_KEY=SCRUM
INCIDENT_AGENT_JIRA_ISSUE_TYPE=Task
INCIDENT_AGENT_JIRA_DONE_TRANSITION_NAME=Done
INCIDENT_AGENT_MCP_ATLASSIAN_PACKAGE=mcp-atlassian>=0.22.0
INCIDENT_AGENT_UV_CACHE_DIR=/tmp/incident-root-cause-agent-uv-cache
INCIDENT_AGENT_UV_TOOL_DIR=/tmp/incident-root-cause-agent-uv-tools

# --- Optional GitHub repository scan via GitHub's official MCP server ---
# Create a fine-grained token with read-only Contents access for selected
# repositories. Never commit the real token.
GITHUB_PERSONAL_ACCESS_TOKEN=
INCIDENT_AGENT_GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/
INCIDENT_AGENT_GITHUB_MAX_SCAN_FILES=40

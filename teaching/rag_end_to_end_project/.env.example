# RAG end-to-end teaching demo — required/optional env vars.
# Backend reads these from a project-level .env here (if present), or
# falls back to the repo-root .env (see backend/config.py). No mock mode:
# OPENAI_API_KEY, QDRANT_URL, and QDRANT_API_KEY are all required.

# Required — OpenAI (chat completions + default embeddings + eval judge)
OPENAI_API_KEY=

# Required — Qdrant Cloud (vector store)
QDRANT_URL=
QDRANT_API_KEY=

# Optional — only needed if the "cohere" embedding option is selected
COHERE_API_KEY=

# Optional — Phoenix observability collector endpoint. If unset, backend
# falls back to a local OSS Phoenix app (if `arize-phoenix` is installed),
# then to structured JSON span logs on stdout as a last resort. See
# backend/observability.py for the full fallback chain.
PHOENIX_COLLECTOR_ENDPOINT=
PHOENIX_API_KEY=
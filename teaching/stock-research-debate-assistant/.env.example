# At least one LLM key is required (backend/agent/config.py fails loudly at
# import time if none are set — no mock mode in this project).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Required for the news-search tool (tavily-mcp)
TAVILY_API_KEY=

# Optional: Phoenix/OpenInference tracing
PHOENIX_COLLECTOR_ENDPOINT=
PHOENIX_API_KEY=

# Optional: override default SQLite memory DB location
STOCK_AGENT_MEMORY_DB=

# Optional: cap LLM output tokens (default 2048, max 4096)
LLM_MAX_OUTPUT_TOKENS=
